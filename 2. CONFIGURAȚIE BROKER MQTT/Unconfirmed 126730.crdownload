#!/usr/bin/env python3
"""
Bridge MQTT to PostgreSQL Database
"""

import paho.mqtt.client as mqtt
import psycopg2
import json
from datetime import datetime
import logging

# Configurare logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Configurație
MQTT_BROKER = "localhost"
MQTT_PORT = 1883
MQTT_TOPICS = [
    "petfeeder/+/status",
    "petfeeder/+/sensors",
    "petfeeder/+/commands",
    "petfeeder/+/logs"
]

# Configurație PostgreSQL
DB_CONFIG = {
    "host": "localhost",
    "database": "petfeeder",
    "user": "postgres",
    "password": "password123"
}

class MQTTDatabaseBridge:
    def __init__(self):
        self.mqtt_client = mqtt.Client()
        self.db_connection = None
        self.setup_mqtt()
        self.setup_database()
    
    def setup_mqtt(self):
        """Configurează clientul MQTT"""
        self.mqtt_client.on_connect = self.on_connect
        self.mqtt_client.on_message = self.on_message
        self.mqtt_client.on_disconnect = self.on_disconnect
    
    def setup_database(self):
        """Configurează conexiunea la baza de date"""
        try:
            self.db_connection = psycopg2.connect(**DB_CONFIG)
            logger.info("Connected to PostgreSQL database")
            
            # Creează tabelele dacă nu există
            self.create_tables()
            
        except Exception as e:
            logger.error(f"Database connection failed: {e}")
    
    def create_tables(self):
        """Creează tabelele necesare în baza de date"""
        create_tables_sql = """
        CREATE TABLE IF NOT EXISTS devices (
            device_id VARCHAR(32) PRIMARY KEY,
            device_name VARCHAR(50),
            mac_address VARCHAR(17),
            firmware_version VARCHAR(20),
            registered_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            last_seen TIMESTAMP
        );
        
        CREATE TABLE IF NOT EXISTS device_status (
            id SERIAL PRIMARY KEY,
            device_id VARCHAR(32) REFERENCES devices(device_id),
            state INTEGER,
            battery INTEGER,
            wifi_connected BOOLEAN,
            mqtt_connected BOOLEAN,
            recorded_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        );
        
        CREATE TABLE IF NOT EXISTS sensor_data (
            id SERIAL PRIMARY KEY,
            device_id VARCHAR(32) REFERENCES devices(device_id),
            temperature FLOAT,
            food_level FLOAT,
            battery INTEGER,
            recorded_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        );
        
        CREATE TABLE IF NOT EXISTS feeding_events (
            id SERIAL PRIMARY KEY,
            device_id VARCHAR(32) REFERENCES devices(device_id),
            trigger_type VARCHAR(20),
            amount INTEGER,
            success BOOLEAN,
            fed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        );
        
        CREATE TABLE IF NOT EXISTS commands_log (
            id SERIAL PRIMARY KEY,
            device_id VARCHAR(32),
            command VARCHAR(50),
            parameters JSONB,
            executed_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        );
        """
        
        try:
            cursor = self.db_connection.cursor()
            cursor.execute(create_tables_sql)
            self.db_connection.commit()
            cursor.close()
            logger.info("Database tables created/verified")
        except Exception as e:
            logger.error(f"Failed to create tables: {e}")
    
    def on_connect(self, client, userdata, flags, rc):
        """Callback pentru conectarea la broker MQTT"""
        if rc == 0:
            logger.info("Connected to MQTT broker")
            # Abonare la topicuri
            for topic in MQTT_TOPICS:
                client.subscribe(topic)
                logger.info(f"Subscribed to {topic}")
        else:
            logger.error(f"Connection failed with code {rc}")
    
    def on_disconnect(self, client, userdata, rc):
        """Callback pentru deconectare"""
        logger.warning(f"Disconnected from MQTT broker (code: {rc})")
    
    def on_message(self, client, userdata, msg):
        """Procesează mesajele MQTT primite"""
        try:
            topic = msg.topic
            payload = json.loads(msg.payload.decode())
            
            logger.info(f"Received message on {topic}")
            
            # Extrage device_id din topic
            device_id = topic.split('/')[1]
            
            # Procesează în funcție de topic
            if "status" in topic:
                self.process_status(device_id, payload)
            elif "sensors" in topic:
                self.process_sensors(device_id, payload)
            elif "logs" in topic and "feeding" in str(payload):
                self.process_feeding_event(device_id, payload)
            elif "commands" in topic:
                self.process_command(device_id, payload)
                
        except json.JSONDecodeError as e:
            logger.error(f"JSON decode error: {e}")
        except Exception as e:
            logger.error(f"Error processing message: {e}")
    
    def process_status(self, device_id, data):
        """Procesează mesaje de status"""
        try:
            cursor = self.db_connection.cursor()
            
            # Actualizează sau inserează device
            cursor.execute("""
                INSERT INTO devices (device_id, last_seen)
                VALUES (%s, %s)
                ON CONFLICT (device_id) 
                DO UPDATE SET last_seen = EXCLUDED.last_seen
            """, (device_id, datetime.now()))
            
            # Inserează status
            cursor.execute("""
                INSERT INTO device_status 
                (device_id, state, battery, wifi_connected, mqtt_connected)
                VALUES (%s, %s, %s, %s, %s)
            """, (
                device_id,
                data.get('state', 0),
                data.get('battery', 0),
                data.get('wifi', 0),
                data.get('mqtt', 0)
            ))
            
            self.db_connection.commit()
            cursor.close()
            
        except Exception as e:
            logger.error(f"Error processing status: {e}")
            self.db_connection.rollback()
    
    def process_sensors(self, device_id, data):
        """Procesează date de la senzori"""
        try:
            cursor = self.db_connection.cursor()
            
            cursor.execute("""
                INSERT INTO sensor_data 
                (device_id, temperature, food_level, battery)
                VALUES (%s, %s, %s, %s)
            """, (
                device_id,
                data.get('temp', 0.0),
                data.get('food', 0.0),
                data.get('battery', 0)
            ))
            
            self.db_connection.commit()
            cursor.close()
            
        except Exception as e:
            logger.error(f"Error processing sensors: {e}")
            self.db_connection.rollback()
    
    def process_feeding_event(self, device_id, data):
        """Procesează evenimente de hrănire"""
        try:
            cursor = self.db_connection.cursor()
            
            cursor.execute("""
                INSERT INTO feeding_events 
                (device_id, trigger_type, amount, success)
                VALUES (%s, %s, %s, %s)
            """, (
                device_id,
                data.get('event', 'unknown'),
                data.get('amount', 0),
                True
            ))
            
            self.db_connection.commit()
            cursor.close()
            
            logger.info(f"Feeding event logged for {device_id}")
            
        except Exception as e:
            logger.error(f"Error processing feeding event: {e}")
            self.db_connection.rollback()
    
    def process_command(self, device_id, data):
        """Loghează comenzi primite"""
        try:
            cursor = self.db_connection.cursor()
            
            cursor.execute("""
                INSERT INTO commands_log 
                (device_id, command, parameters)
                VALUES (%s, %s, %s)
            """, (
                device_id,
                data.get('cmd', 'unknown'),
                json.dumps(data)
            ))
            
            self.db_connection.commit()
            cursor.close()
            
        except Exception as e:
            logger.error(f"Error logging command: {e}")
            self.db_connection.rollback()
    
    def run(self):
        """Rulează bridge-ul"""
        try:
            self.mqtt_client.connect(MQTT_BROKER, MQTT_PORT, 60)
            self.mqtt_client.loop_forever()
        except KeyboardInterrupt:
            logger.info("Shutting down...")
            self.mqtt_client.disconnect()
            if self.db_connection:
                self.db_connection.close()
        except Exception as e:
            logger.error(f"Bridge error: {e}")

if __name__ == "__main__":
    bridge = MQTTDatabaseBridge()
    bridge.run()